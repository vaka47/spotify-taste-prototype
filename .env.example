# Public identifier from Spotify Developer Dashboard. This is not a client secret.
SPOTIFY_CLIENT_ID=your_spotify_client_id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Generate long random strings and keep them out of git.
SESSION_SECRET=generate_a_long_random_value
TOKEN_ENCRYPTION_KEY=generate_a_second_long_random_value

# PostgreSQL / Neon connection string. Vercel's Neon integration can inject this.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
